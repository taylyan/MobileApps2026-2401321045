<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvTripSpecies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pheasant"
        android:textColor="#234D32"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTripDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-11-18"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvTripLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kuklen"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvTripNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Morning hunting trip"
        android:textColor="#777777"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnEditTrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit" />

        <Button
            android:id="@+id/btnDeleteTrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Delete" />

    </LinearLayout>


</LinearLayout>
