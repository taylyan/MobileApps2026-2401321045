<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F6F3">
    <include layout="@layout/layout_back_button" />

    <TextView
        android:id="@+id/tvCollectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Collection"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#234D32"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAddCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New" />

    <TextView
        android:id="@+id/tvCollectionEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No records yet."
        android:gravity="center"
        android:padding="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>
