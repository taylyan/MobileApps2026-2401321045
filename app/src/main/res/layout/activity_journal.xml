<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/hs_background">

    <include layout="@layout/layout_back_button" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hunting Journal"
        android:textColor="@color/hs_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep track of your hunting adventures"
        android:textColor="@color/hs_text_secondary"
        android:textSize="15sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAddHunt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Hunting Trip" />

    <TextView
        android:id="@+id/tvEmptyJournal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hunting trips yet. Add your first one!"
        android:textColor="@color/hs_text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="40dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHuntingTrips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false" />

</LinearLayout>
