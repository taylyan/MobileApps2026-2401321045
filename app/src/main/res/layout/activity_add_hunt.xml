<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F3">
    <include layout="@layout/layout_back_button" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Hunting Trip"
            android:textColor="#234D32"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etHuntDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date (YYYY-MM-DD)"
            android:inputType="date" />

        <EditText
            android:id="@+id/etHuntLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etGameSpecies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Game Species"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etHuntNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:gravity="top|start" />

        <Button
            android:id="@+id/btnSaveHunt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Trip"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
